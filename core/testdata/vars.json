    { "tpl": "{empty}|{x_1}", "out": "|ok", "missing": [], "used": ["empty", "x_1"] },
    { "tpl": "unclosed {name", "out": "unclosed {name", "missing": [], "used": [] },
    { "tpl": "a}b", "out": "a}b", "missing": [], "used": [] },
