<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="toolbox.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Toolbox\Toolbox">
    </Installer>
    <PackageInformation
        PackageName="Toolbox"
        PackageDisplayName="Toolbox"
        PublisherName="CN=Toolbox"
        PublisherDisplayName="Toolbox"
        Version="0.1.0.0"
        PackageDescription="Local media and utility toolbox">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="dev.toolbox.app"
                Description="Local media and utility toolbox"
                DisplayName="Toolbox"
                ExecutableName="toolbox.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Toolbox</DisplayName>
            <PublisherDisplayName>Toolbox</PublisherDisplayName>
            <Description>Local media and utility toolbox</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="toolbox.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
